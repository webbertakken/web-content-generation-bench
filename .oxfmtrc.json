{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".yarn/",
    ".tmp/",
    "dist/",
    "build/",
    "out/",
    "_site/",
    ".next/",
    ".svelte-kit/",
    ".astro/",
    ".eleventy-cache/",
    "bench/results/",
    "packages/data/dist/",
    "yarn.lock",
    "*.min.js",
    "*.min.css"
  ]
}
